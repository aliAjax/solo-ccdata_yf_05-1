{
  "name": "ccdata-yf-05-license-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:logic": "node -e \"require('node:fs').mkdirSync('tests/.out',{recursive:true})\" && rolldown tests/logic.test.ts --format cjs --platform node --external node:test,node:assert --file tests/.out/logic.test.cjs && node --test tests/.out/logic.test.cjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright": "^1.63.0",
    "rolldown": "^1.2.8"
  }
}
